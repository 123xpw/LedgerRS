  "query": "UPDATE ledgers\n             SET name            = COALESCE($2, name),\n                 icon            = COALESCE($3, icon),\n                 initial_balance = COALESCE($4, initial_balance),\n                 updated_at      = NOW()\n             WHERE id = $1\n             RETURNING id, user_id, name, icon, base_currency, initial_balance, created_at, updated_at",
