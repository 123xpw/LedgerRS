  "db_name": "PostgreSQL",
  "query": "SELECT tt.transaction_id, t.id, t.ledger_id, t.name, t.created_at\n             FROM tags t\n             JOIN transaction_tags tt ON tt.tag_id = t.id\n             WHERE tt.transaction_id = ANY($1)\n             ORDER BY t.name ASC",
